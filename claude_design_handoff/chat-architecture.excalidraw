    {
      "type": "text", "id": "evA1_t", "x": 88, "y": 556, "width": 364, "height": 128,
      "text": "-- a notebook fetches its chats by\n-- reverse-traversing the edge:\nselect <- chat_session as chat_session\nfrom refers_to\nwhere out = $notebook_id\norder by chat_session.updated desc",
